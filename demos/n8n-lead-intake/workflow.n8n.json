    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst name = String(input.name ?? '').trim();\nconst email = String(input.email ?? '').trim().toLowerCase();\nconst company = String(input.company ?? '').trim();\nconst rawBudget = Number(input.budget ?? 0);\nconst budget = Number.isFinite(rawBudget) ? Math.max(0, rawBudget) : 0;\nconst valid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nlet route = 'reject';\nlet priority = 'none';\nif (valid && budget >= 1000) { route = 'sales'; priority = 'high'; }\nelse if (valid && budget >= 250) { route = 'sales'; priority = 'normal'; }\nelse if (valid) { route = 'nurture'; priority = 'low'; }\nreturn [{ json: { name, email, company, budget, valid, route, priority } }];"
      },
      "id": "2",
      "name": "Normalize + Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3",
      "name": "Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { accepted: true, route: $json.route, priority: $json.priority } }}",
        "options": { "responseCode": 202 }
      },
      "id": "4",
